# ---------------------------------------------------------------------------
# The previous card game, kept on disk but deliberately out of this repository.
#
# cardgame-ref/ is the earlier attempt. Its game design is superseded; what was
# worth keeping from its architecture is written down in docs/GAME_DESIGN.md §14.
# The folder stays on the developer's machine as a read-only reference and is
# not part of this project's history. A fresh clone will not have it.
# ---------------------------------------------------------------------------
cardgame-ref/

# --- Godot ---------------------------------------------------------------
.godot/
/android/
/build/
/exports/
*.translation
# contains local paths and can carry signing secrets
export_presets.cfg

# --- .NET / C# -----------------------------------------------------------
**/bin/
**/obj/
.mono/
*.user
*.userprefs
*.suo

# --- PolyTools sync --------------------------------------------------------
# The sync stages the new assets and parks the old ones beside the target and
# removes both when it finishes; these only survive a sync that was killed.
# The synced assets themselves are committed.
.polytools-staging.*/
.polytools-backup.*/

# --- the check watcher's answers -----------------------------------------
.agent-check/

# --- IDEs ----------------------------------------------------------------
.idea/
.vs/

# --- macOS ---------------------------------------------------------------
.DS_Store

# _to_delete/ is deliberately NOT ignored: it stays untracked but visible, so
# that it shows up in `git status` and gets emptied with `trash` at the end of
# the day. Never stage it.
