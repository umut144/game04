; Engine configuration file.
; It's best edited using the editor UI and not directly, since the parameters
; that go here are meant to be edited by the editor.
;
; G01: BoardGridPreview is a provisional evaluation scene, not the real game
; scene. It shows the board-grid geometry proposed in docs/TASKS.md's G01
; layout math (see Cardgame.App/Presentation/BoardLayoutSpec.cs) so it can be
; judged on the client before the layout is settled. Swap main_scene once a
; real menu/match scene exists.

config_version=5

[application]

config/name="game04"
run/main_scene="res://Presentation/BoardGridPreview.tscn"
config/features=PackedStringArray("4.7", "C#")

[display]

window/size/viewport_width=2560
window/size/viewport_height=1600
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[dotnet]

project/assembly_name="Cardgame.App"
